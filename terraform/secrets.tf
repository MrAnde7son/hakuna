# ── Secret Manager ────────────────────────────────────────────────────────────
# All runtime secrets live here. Never in env vars or Terraform state (except db_password
# which is generated by Terraform — see note below).

# DB password — generated by Terraform, stored in Secret Manager.
# The password value IS in Terraform state (GCS bucket).
# For higher security in Phase 2: migrate to Cloud SQL IAM database auth (no password).
resource "google_secret_manager_secret" "db_password" {
  secret_id = "hakuna-db-password"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "db_password" {
  secret      = google_secret_manager_secret.db_password.id
  secret_data = random_password.db_password.result
}

# Full database URL — stored as a secret so the password isn't in plain env vars
resource "google_secret_manager_secret" "database_url" {
  secret_id = "hakuna-database-url"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "database_url" {
  secret      = google_secret_manager_secret.database_url.id
  secret_data = "postgresql://hakuna:${random_password.db_password.result}@localhost:5432/hakuna"
}

# Redis URL — assembled from Memorystore host
resource "google_secret_manager_secret" "redis_url" {
  secret_id = "hakuna-redis-url"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "redis_url" {
  secret      = google_secret_manager_secret.redis_url.id
  secret_data = "redis://${google_redis_instance.main.host}:${google_redis_instance.main.port}/0"
}

# JWT signing secret
resource "google_secret_manager_secret" "jwt_secret" {
  secret_id = "hakuna-jwt-secret"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "jwt_secret" {
  secret      = google_secret_manager_secret.jwt_secret.id
  secret_data = var.jwt_secret
}

# Sentry DSN — optional, leave var empty to disable
resource "google_secret_manager_secret" "sentry_dsn" {
  secret_id = "hakuna-sentry-dsn"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "sentry_dsn" {
  secret      = google_secret_manager_secret.sentry_dsn.id
  secret_data = var.sentry_dsn != "" ? var.sentry_dsn : "disabled"
}

# AES-256 key for encrypting integration credentials (e.g. VulnCheck tokens)
# MUST be stable — changing it invalidates all stored credentials and requires re-entering them.
resource "google_secret_manager_secret" "integration_secret_key" {
  secret_id = "hakuna-integration-secret-key"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "integration_secret_key" {
  secret      = google_secret_manager_secret.integration_secret_key.id
  secret_data = var.integration_secret_key
}

# Brevo SMTP API key — used for password reset emails and workflow alert fallback
resource "google_secret_manager_secret" "brevo_smtp_pass" {
  secret_id = "hakuna-brevo-smtp-pass"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "brevo_smtp_pass" {
  secret      = google_secret_manager_secret.brevo_smtp_pass.id
  secret_data = var.brevo_smtp_pass
}
