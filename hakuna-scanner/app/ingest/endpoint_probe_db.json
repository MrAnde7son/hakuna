{
  "_comment": "Default endpoint probing database. Each entry defines a path to request and conditions that confirm the technology. Only high-confidence probes — we check status code and optionally a body pattern to avoid false positives from generic 200 responses or custom error pages.",

  "probes": [
    {
      "path": "/wp-login.php",
      "name": "WordPress",
      "cpe_vendor": "wordpress",
      "cpe_product": "wordpress",
      "match_status": [200],
      "body_pattern": "wp-login|WordPress",
      "version_pattern": "ver=(?P<version>[0-9][0-9.]*)"
    },
    {
      "path": "/wp-json/wp/v2/",
      "name": "WordPress REST API",
      "cpe_vendor": "wordpress",
      "cpe_product": "wordpress",
      "match_status": [200],
      "body_pattern": "\"namespace\"\\s*:\\s*\"wp/v2\""
    },
    {
      "path": "/xmlrpc.php",
      "name": "WordPress XML-RPC",
      "cpe_vendor": "wordpress",
      "cpe_product": "wordpress",
