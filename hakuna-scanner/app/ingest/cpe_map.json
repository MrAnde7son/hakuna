{
  "_comment": "CPE inference mapping table. Maps tech-detection signals (httpx -tech-detect tokens, HTTP Server header substrings, TLS cert subject CNs) to CPE 2.3 vendor:product pairs. CONTRACT: every {vendor, product} pair emitted from this file MUST exist as a key in hakuna-vm-scanner/templates/routing_table.json `cpe_map`. The regression test in tests/test_cpe_router_contract.py enforces this.",

  "tech_to_cpe": {
    "nginx":                {"vendor": "nginx",      "product": "nginx"},
    "apache":               {"vendor": "apache",     "product": "http_server"},
