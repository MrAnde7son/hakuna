  "server_header_to_cpe": [
    {"match": "microsoft-iis", "vendor": "microsoft", "product": "iis"},
    {"match": "apache-coyote", "vendor": "apache",    "product": "tomcat"},
    {"match": "apache",        "vendor": "apache",    "product": "http_server"},
