    "schema_version": "1"
  },
  "jquery": {
    "extractors": {
      "filename": ["jquery-(?P<version>[0-9._-]+)(?:\\.min)?\\.js"],
      "uri": ["jquery[/-](?P<version>[0-9._-]+)(?:\\.min)?\\.js"],
      "filecontent": ["jQuery JavaScript Library v(?P<version>[0-9._]+)"]
    },
    "vulnerabilities": [
