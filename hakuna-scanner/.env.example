# Database
DATABASE_URL=postgresql+asyncpg://hakuna:hakuna@postgres:5432/hakuna
DATABASE_URL_SYNC=postgresql://hakuna:hakuna@postgres:5432/hakuna

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_CONCURRENCY=4

# Scanner
SCAN_TIMEOUT_SECONDS=600
NAABU_PORTS=80,443,8080,8443,8888,9000,9443,3000,5000
SUBFINDER_SOURCES=all
UNCOVER_SOURCES=shodan,censys,fofa
ORG_SCAN_STAGGER_SECONDS=30

# API Keys (optional — tools degrade gracefully without them)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
FOFA_EMAIL=
FOFA_KEY=
OTX_API_KEY=
CHAOS_API_KEY=
