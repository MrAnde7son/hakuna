# VM Scanner — Environment Variables

# Database (same Postgres as Pipeline A)
DATABASE_URL=postgresql://hakuna:hakuna@postgres:5432/hakuna

# Celery (use different Redis DB to avoid queue collision)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Nuclei
NUCLEI_BIN=/usr/local/bin/nuclei
NUCLEI_TIMEOUT=30
NUCLEI_RATE_LIMIT=150
SCAN_TIMEOUT_SECONDS=600

# Templates
TEMPLATES_DIR=/app/templates
