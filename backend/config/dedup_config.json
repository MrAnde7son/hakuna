{
  "enabled": true,
  "apply_on_upload": true,
  "assets": {
    "host": {
      "enabled": true,
      "key_fields": [
        "ip",
        "fqdn"
      ],
      "key_mode": "or",
      "strategy": "merge",
      "scope": "cross_scan",
      "source_priority": {
        "*": [],
        "hostname": [
          "nessus"
        ]
      }
    },
    "web_app": {
      "enabled": true,
      "key_fields": [
        "url"
      ],
      "key_mode": "and",
      "strategy": "keep_last",
      "scope": "cross_scan"
    },
    "cloud_instance": {
      "enabled": true,
      "key_fields": [
        "cloud_provider",
        "instance_id"
      ],
      "key_mode": "and",
      "strategy": "merge",
      "scope": "cross_scan"
    },
    "api_endpoint": {
      "enabled": true,
      "key_fields": [
        "method",
        "url"
      ],
      "key_mode": "and",
      "strategy": "keep_last",
      "scope": "cross_scan"
    },
    "identity": {
      "enabled": true,
      "key_fields": [
        "provider",
        "principal_id"
      ],
      "key_mode": "and",
      "strategy": "merge",
      "scope": "cross_scan"
    },
    "container_image": {
      "enabled": true,
      "key_fields": [
        "registry",
        "repository",
        "digest"
      ],
      "key_mode": "and",
      "strategy": "keep_last",
      "scope": "cross_scan"
    },
    "code_repo": {
      "enabled": true,
      "key_fields": [
        "provider",
        "org",
        "repo"
      ],
      "key_mode": "and",
      "strategy": "merge",
      "scope": "cross_scan"
    },
    "k8s_workload": {
      "enabled": true,
      "key_fields": [
        "cluster",
        "namespace",
        "kind",
        "name"
      ],
      "key_mode": "and",
      "strategy": "merge",
      "scope": "cross_scan"
    }
  },
  "findings": {
    "enabled": true,
    "key_fields": [
      "plugin_id",
      "asset_id",
      "port"
    ],
    "strategy": "keep_last",
    "scope": "cross_scan"
  },
  "inventory": {
    "users": {
      "enabled": true,
      "key_fields": [
        "username",
        "domain"
      ],
      "strategy": "merge"
    },
    "groups": {
      "enabled": true,
      "key_fields": [
        "group_name",
        "domain"
      ],
      "strategy": "merge"
    },
    "computers": {
      "enabled": true,
      "key_fields": [
        "computer_name",
        "sid"
      ],
      "strategy": "merge"
    },
    "services": {
      "enabled": true,
      "key_fields": [
        "service_name",
        "asset_id"
      ],
      "strategy": "merge"
    },
    "software": {
      "enabled": true,
      "key_fields": [
        "name",
        "version",
        "asset_id"
      ],
      "strategy": "keep_first"
    },
    "shares": {
      "enabled": true,
      "key_fields": [
        "share_name",
        "asset_id"
      ],
      "strategy": "merge"
    },
    "netconns": {
      "enabled": true,
      "key_fields": [
        "local_addr",
        "local_port",
        "remote_addr",
        "remote_port",
        "asset_id"
      ],
      "strategy": "keep_first"
    },
    "patches": {
      "enabled": true,
      "key_fields": [
        "kb_id",
        "asset_id"
      ],
      "strategy": "keep_last"
    },
    "security_controls": {
      "enabled": true,
      "key_fields": [
        "control_type",
        "asset_id"
      ],
      "strategy": "merge"
    },
    "password_policies": {
      "enabled": true,
      "key_fields": [
        "domain"
      ],
      "strategy": "merge"
    },
    "logged_on": {
      "enabled": true,
      "key_fields": [
        "username",
        "domain",
        "asset_id"
      ],
      "strategy": "keep_last"
    },
    "scheduled_tasks": {
      "enabled": true,
      "key_fields": [
        "task_uri",
        "asset_id"
      ],
      "strategy": "merge"
    },
    "env_vars": {
      "enabled": true,
      "key_fields": [
        "name",
        "asset_id"
      ],
      "strategy": "keep_last"
    },
    "processes": {
      "enabled": true,
      "key_fields": [
        "process_name",
        "pid",
        "asset_id"
      ],
      "strategy": "keep_last"
    },
    "certificates": {
      "enabled": true,
      "key_fields": [
        "subject_cn",
        "serial_number",
        "asset_id"
      ],
      "strategy": "keep_last"
    },
    "database_instances": {
      "enabled": true,
      "key_fields": [
        "db_type",
        "instance_name",
        "port",
        "asset_id"
      ],
      "strategy": "keep_last"
    }
  }
}