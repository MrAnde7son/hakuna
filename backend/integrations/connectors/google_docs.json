{
  "id": "google_docs",
  "name": "Google Drive — Security Documents",
  "description": "Pull documents from Google Drive and extract security findings using AI. Supports Google Docs, Sheets, and uploaded PDFs in a specified folder.",
  "logo": "/logos/vendors/google-drive.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://www.googleapis.com",
    "steps": [
      {
        "id": "list_files",
        "method": "GET",
        "path": "/drive/v3/files",
        "headers": {
          "Authorization": "Bearer {{credentials.access_token}}"
        },
        "query_params": {
          "q": "{{params.query}}",
          "fields": "files(id,name,mimeType,webViewLink,modifiedTime),nextPageToken",
          "pageSize": "50",
          "pageToken": "{{pagination.cursor}}",
          "orderBy": "modifiedTime desc"
        }
      },
      {
        "id": "export_content",
        "method": "GET",
        "path": "/drive/v3/files/{{record.id}}/export",
        "headers": {
          "Authorization": "Bearer {{credentials.access_token}}"
        },
        "query_params": {
          "mimeType": "text/plain"
        },
        "per_record": true,
        "inject_as": "exported_text"
      }
    ],
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "nextPageToken",
      "page_size": 50
    },
    "llm_extract": {
      "text_field": "exported_text",
      "title_field": "name",
      "url_field": "webViewLink"
    }
  },
  "records_path": "files",
  "credential_acquisition": {
    "pattern": "oauth2",
    "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_url": "https://oauth2.googleapis.com/token",
    "token_request_format": "form",
    "client_id": "{{env.GOOGLE_CLIENT_ID}}",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly"],
    "extra_params": {
      "access_type": "offline",
      "prompt": "consent"
    },
    "pkce": false,
    "popup": { "width": 500, "height": 600 },
    "validation_request": {
      "method": "GET",
      "path": "/drive/v3/about?fields=user",
      "success_condition": "status == 200",
      "success_extracts": {
        "connected_user": "user.displayName",
        "connected_email": "user.emailAddress"
      }
    }
  },
  "default_field_map": [
    { "source": "finding_id", "target": "source_id" },
    { "source": "title", "target": "title" },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info",
          "informational": "info"
        }
      }
    },
    { "source": "affected_host", "target": "asset.ip_address" },
    { "source": "hostname", "target": "asset.hostname" },
    { "source": "cvss_score", "target": "cvss_score", "transform": { "type": "float" } },
    { "source": "cve_id", "target": "cve_id" },
    { "source": "description", "target": "description" },
    { "source": "recommendation", "target": "solution" },
    { "source": "evidence", "target": "plugin_output" },
    { "source": "references", "target": "references" },
    {
      "source": "exploit_available",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["true", "True", "1", "yes"]
      }
    }
  ],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "query": {
      "type": "string",
      "required": false,
      "default": "mimeType='application/vnd.google-apps.document' and trashed=false",
      "description": "Google Drive search query. Default: all Google Docs. Use \"'FOLDER_ID' in parents\" to limit to a folder."
    }
  }
}
