{
  "id": "tanium_patch_action",
  "name": "Tanium \u2014 Deploy Patch",
  "description": "Deploy patches to endpoints via Tanium",
  "category": "Patch Management",
  "logo": "/logos/vendors/tanium.svg",
  "direction": "push",
  "entity": "action",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "POST",
    "path": "/api/v2/patch/deployments",
    "headers": {
      "session": "{{credentials.api_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targets": {
        "computer_names": ["{{asset.hostname}}"]
      },
      "patches": {
        "cve_ids": ["{{finding.cve_id}}"]
      },
      "schedule": {
        "start_time": "now"
      }
    }
  },
  "records_path": null,
  "credential_acquisition": {
    "pattern": "guided_generation",
    "instance_url_field": {
      "label": "Tanium Server URL",
      "placeholder": "https://tanium.yourcompany.com"
    },
    "steps": [
      {
        "instruction": "Log into the Tanium console as an administrator",
        "deeplink_path": null
      },
      {
        "instruction": "Navigate to Administration \u2192 Permissions \u2192 API Tokens",
        "deeplink_path": "/administration/permissions/api-tokens"
      },
      {
        "instruction": "Generate a new API token with patch deployment permissions. Copy the token value.",
        "capture": {
          "field": "api_token",
          "label": "Paste API Token here",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/api/v2/session/current",
      "auth_header": "session: {{api_token}}",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Tanium. Check your API token and instance URL."
    }
  },
  "default_field_map": [],
  "dedup_key": [],
  "params_schema": {
    "maintenance_window": {
      "type": "string",
      "required": false,
      "description": "Schedule deployment window (ISO 8601 duration, e.g. PT2H)"
    },
    "restart_policy": {
      "type": "string",
      "default": "if_required",
      "description": "Restart behavior: never, if_required, always"
    }
  }
}
