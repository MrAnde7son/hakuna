{
  "id": "mandiant_findings",
  "relay_capable": false,
  "name": "Mandiant Advantage \u2014 Vulnerabilities",
  "description": "Pull vulnerability intelligence from Mandiant Advantage Threat Intelligence",
  "category": "Threat Intelligence",
  "logo": "/logos/vendors/mandiant.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.intelligence.mandiant.com",
    "method": "GET",
    "path": "/v4/vulnerability",
    "headers": {
      "Accept": "application/json",
      "X-App-Name": "hakuna-integration"
    },
    "query_params": {
      "limit": "100",
      "next": "{{pagination.cursor}}"
    },
    "pagination": {
      "strategy": "cursor",
      "page_size": 100,
      "cursor_field": "next",
      "cursor_param": "next"
    }
  },
  "records_path": "vulnerability",
  "credential_acquisition": {
    "pattern": "client_credentials",
    "token_url": "https://api.intelligence.mandiant.com/token",
    "fields": [
      {
        "field": "public_key",
        "label": "Public Key (API Key ID)",
        "type": "text",
        "help": "From your Mandiant Advantage API settings"
      },
      {
        "field": "private_key",
        "label": "Private Key (API Secret)",
        "type": "password",
        "help": "Generated when you created the API key pair"
      }
    ],
    "token_request": {
      "grant_type": "client_credentials"
    },
    "validation_request": {
      "method": "GET",
      "path": "/v4/vulnerability?limit=1",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Mandiant. Verify your public and private keys."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "risk_rating",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low"
        }
      }
    },
    {
      "source": "cve_id",
      "target": "cve_id"
    },
    {
      "source": "cvss_v3.base_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "cvss_v3.vector_string",
      "target": "cvss_vector"
    },
    {
      "source": "is_exploited",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["true", "True"]
      }
    },
    {
      "source": "mitigation",
      "target": "solution"
    },
    {
      "source": "publish_date",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_modified_date",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {}
}
