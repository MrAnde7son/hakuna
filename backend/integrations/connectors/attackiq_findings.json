{
  "id": "attackiq_findings",
  "name": "AttackIQ — Findings",
  "description": "Pull assessment results and security control validation findings from AttackIQ",
  "category": "BAS",
  "logo": "/logos/vendors/attackiq.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://{{credentials.region}}.attackiq.com",
    "method": "GET",
    "path": "/api/v1/assessments/results",
    "headers": {
      "Accept": "application/json"
    },
    "query_params": {
      "page_size": "100"
    },
    "pagination": {
      "strategy": "offset",
      "page_size": 100,
      "offset_param": "page"
    }
  },
  "records_path": "results",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "fields": [
      {
        "field": "region",
        "label": "Region",
        "type": "select",
        "options": ["us1", "eu1"],
        "default": "us1",
        "help": "AttackIQ data center region"
      },
      {
        "field": "api_token",
        "label": "API Token",
        "type": "password",
        "help": "API token from AttackIQ Settings → API Tokens"
      }
    ],
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_value": "Token {{credentials.api_token}}",
    "validation_request": {
      "method": "GET",
      "path": "/api/v1/assessments?page_size=1",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with AttackIQ. Verify your region and API token."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "scenario_name",
      "target": "title"
    },
    {
      "source": "scenario_description",
      "target": "description"
    },
    {
      "source": "outcome",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "Failed": "critical",
          "Errored": "high",
          "Detected": "medium",
          "Blocked": "info",
          "Passed": "info"
        }
      }
    },
    {
      "source": "target_agent.ip",
      "target": "asset.ip_address"
    },
    {
      "source": "target_agent.hostname",
      "target": "asset.hostname"
    },
    {
      "source": "cve_ids",
      "target": "cve_id",
      "transform": {
        "type": "first"
      }
    },
    {
      "source": "mitre_attack_id",
      "target": "mitre_technique_id"
    },
    {
      "source": "remediation",
      "target": "solution"
    },
    {
      "source": "created",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_run",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "assessment_id": {
      "type": "string",
      "default": "",
      "description": "Filter results to a specific assessment ID"
    },
    "outcome": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["Failed", "Errored"],
      "description": "Filter by outcome (Failed, Errored, Detected, Blocked, Passed)"
    }
  }
}
