{
  "id": "tenable_io_findings",
  "name": "Tenable.io \u2014 Findings",
  "description": "Pull vulnerability findings from Tenable.io via the vulnerability export API",
  "logo": "/logos/vendors/tenable.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://cloud.tenable.com",
    "method": "GET",
    "path": "/vulns/export",
    "headers": {
      "Accept": "application/json",
      "X-ApiKeys": "accessKey={{credentials.access_key}};secretKey={{credentials.secret_key}}"
    },
    "query_params": {
      "num_assets": "500"
    },
    "pagination": {
      "strategy": "cursor",
      "page_size": 500,
      "cursor_field": "export_uuid",
      "next_path": "/vulns/export/{{cursor}}/chunks/{{chunk_id}}"
    }
  },
  "records_path": "vulnerabilities",
  "credential_acquisition": {
    "pattern": "auto_provision",
    "description": "Hakuna will create a dedicated hakuna-integration service user in your Tenable.io account with minimum required permissions.",
    "provisioning_steps": [
      {
        "method": "POST",
        "path": "/users",
        "body": {
          "username": "hakuna-integration",
          "permissions": 32,
          "type": "service"
        },
        "success_extracts": {
          "user_id": "response.uuid",
          "access_key": "response.access_key",
          "secret_key": "response.secret_key"
        }
      }
    ],
    "admin_credential_prompt": {
      "steps": [
        {
          "instruction": "Provide an administrator API key to create the service account",
          "capture": {
            "field": "admin_access_key",
            "label": "Admin Access Key",
            "type": "password",
            "auto_validate": true
          }
        },
        {
          "instruction": "Provide the admin secret key",
          "capture": {
            "field": "admin_secret_key",
            "label": "Admin Secret Key",
            "type": "password",
            "auto_validate": true
          }
        }
      ]
    },
    "validation_request": {
      "method": "GET",
      "path": "/server/status",
      "headers": {
        "X-ApiKeys": "accessKey={{access_key}};secretKey={{secret_key}}"
      },
      "success_condition": "status == 200",
      "success_extracts": {
        "connected_user": "hakuna-integration"
      },
      "error_message": "Could not authenticate with Tenable.io. Check the API keys and try again."
    }
  },
  "default_field_map": [
    {
      "source": "plugin.id",
      "target": "plugin_id"
    },
    {
      "source": "plugin.name",
      "target": "title"
    },
    {
      "source": "asset.hostname",
      "target": "asset.hostname"
    },
    {
      "source": "asset.ipv4",
      "target": "asset.ip_address"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info"
        }
      }
    },
    {
      "source": "plugin.cvss3_base_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "plugin.cve[0]",
      "target": "cve_id"
    },
    {
      "source": "plugin.exploit_available",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": [
          "true",
          "True",
          "1"
        ]
      }
    },
    {
      "source": "plugin.solution",
      "target": "solution"
    },
    {
      "source": "first_found",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_found",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "plugin_id",
    "asset.ip_address"
  ],
  "params_schema": {
    "num_assets": {
      "type": "integer",
      "default": 500,
      "description": "Number of assets per export chunk"
    },
    "severity": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Filter by severity (critical, high, medium, low, info)"
    }
  }
}