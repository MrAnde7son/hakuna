{
  "id": "qualys_findings",
  "name": "Qualys \u2014 Findings",
  "description": "Pull vulnerability detections from Qualys VM",
  "logo": "/logos/vendors/qualys.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "POST",
    "path": "/api/2.0/fo/asset/host/vm/detection/",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded",
      "X-Requested-With": "curl"
    },
    "body": {
      "action": "list",
      "show_igs": "1",
      "output_format": "JSON"
    },
    "pagination": {
      "strategy": "offset",
      "page_size": 1000,
      "offset_param": "id_min"
    }
  },
  "records_path": "HOST_LIST_VM_DETECTION_OUTPUT.RESPONSE.HOST_LIST.HOST",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "instance_url_field": {
      "label": "Qualys API URL",
      "placeholder": "https://qualysapi.qualys.com"
    },
    "steps": [
      {
        "instruction": "Log into Qualys as an administrator"
      },
      {
        "instruction": "Go to Subscription \u2192 Users \u2192 Your User \u2192 API credentials"
      },
      {
        "instruction": "Copy your Qualys username",
        "capture": {
          "field": "username",
          "label": "Qualys API Username",
          "type": "text",
          "auto_validate": false
        }
      },
      {
        "instruction": "Copy your Qualys password",
        "capture": {
          "field": "password",
          "label": "Qualys API Password",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "POST",
      "path": "/api/2.0/fo/asset/host/?action=list&truncation_limit=1",
      "auth": "basic",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate. Check your credentials."
    }
  },
  "default_field_map": [
    {
      "source": "QID",
      "target": "plugin_id"
    },
    {
      "source": "TITLE",
      "target": "title"
    },
    {
      "source": "IP",
      "target": "asset.ip_address"
    },
    {
      "source": "DNS",
      "target": "asset.hostname"
    },
    {
      "source": "SEVERITY",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "5": "critical",
          "4": "high",
          "3": "medium",
          "2": "low",
          "1": "info"
        }
      }
    },
    {
      "source": "CVSS_BASE",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "CVE_ID_LIST.CVE_ID[0]",
      "target": "cve_id"
    },
    {
      "source": "SOLUTION",
      "target": "solution"
    },
    {
      "source": "FIRST_FOUND_DATETIME",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "LAST_FOUND_DATETIME",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id",
    "asset.ip_address"
  ],
  "params_schema": {}
}