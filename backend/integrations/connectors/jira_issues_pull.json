{
  "id": "jira_issues_pull",
  "relay_capable": true,
  "name": "Jira — Pull Issues",
  "description": "Pull issues from Jira using JQL queries",
  "logo": "/logos/vendors/jira.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "GET",
    "path": "/rest/api/3/search",
    "headers": { "Accept": "application/json" },
    "query_params": {
      "jql": "{{params.jql}}",
      "maxResults": "100",
      "startAt": "{{pagination.offset}}",
      "fields": "summary,description,status,priority,assignee,created,updated,labels,components,issuetype,resolution"
    },
    "pagination": {
      "strategy": "offset",
      "page_size": 100,
      "offset_param": "startAt",
      "total_field": "total"
    }
  },
  "records_path": "issues",
  "credential_acquisition": {
    "pattern": "oauth2",
    "instance_url_field": {
      "label": "Your Jira workspace URL",
      "placeholder": "https://yourcompany.atlassian.net"
    },
    "authorization_url": "https://auth.atlassian.com/authorize",
    "token_url": "https://auth.atlassian.com/oauth/token",
    "token_request_format": "json",
    "client_id": "{{env.JIRA_CLIENT_ID}}",
    "scopes": ["read:jira-work", "offline_access"],
    "extra_params": {
      "audience": "api.atlassian.com",
      "prompt": "consent"
    },
    "pkce": true,
    "popup": { "width": 600, "height": 700 },
    "validation_request": {
      "method": "GET",
      "path": "/rest/api/3/myself",
      "success_extracts": {
        "connected_user": "response.displayName",
        "connected_email": "response.emailAddress"
      }
    }
  },
  "default_field_map": [
    { "source": "key", "target": "source_id" },
    { "source": "fields.summary", "target": "title" },
    { "source": "fields.description.content[0].content[0].text", "target": "description" },
    { "source": "fields.status.name", "target": "status" },
    {
      "source": "fields.priority.name",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": { "Highest": "critical", "High": "high", "Medium": "medium", "Low": "low", "Lowest": "info" }
      }
    },
    { "source": "fields.assignee.displayName", "target": "assignee" },
    { "source": "fields.issuetype.name", "target": "issue_type" },
    { "source": "fields.labels", "target": "tags" },
    { "source": "fields.components[0].name", "target": "asset.hostname" },
    { "source": "fields.created", "target": "first_seen", "transform": { "type": "datetime" } },
    { "source": "fields.updated", "target": "last_seen", "transform": { "type": "datetime" } }
  ],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "jql": {
      "type": "string",
      "required": true,
      "description": "JQL query to filter issues (e.g. 'project = SEC AND status != Done')"
    }
  }
}
