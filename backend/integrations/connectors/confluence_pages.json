{
  "id": "confluence_pages",
  "name": "Confluence — Security Pages",
  "description": "Pull security-related pages from Confluence Cloud and extract findings using AI. Ingests wiki pages, runbooks, audit notes, and incident reports as structured vulnerability findings.",
  "logo": "/logos/vendors/confluence.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "GET",
    "path": "/wiki/api/v2/pages",
    "headers": {
      "Accept": "application/json"
    },
    "query_params": {
      "space-id": "{{params.space_id}}",
      "status": "current",
      "sort": "-modified-date",
      "body-format": "storage",
      "limit": "50",
      "cursor": "{{pagination.cursor}}"
    },
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "_links.next",
      "page_size": 50
    },
    "llm_extract": {
      "text_field": "body.storage.value",
      "title_field": "title",
      "url_field": "_links.webui"
    }
  },
  "records_path": "results",
  "credential_acquisition": {
    "pattern": "oauth2",
    "instance_url_field": {
      "label": "Your Atlassian workspace URL",
      "placeholder": "https://yourcompany.atlassian.net"
    },
    "authorization_url": "https://auth.atlassian.com/authorize",
    "token_url": "https://auth.atlassian.com/oauth/token",
    "token_request_format": "json",
    "client_id": "{{env.CONFLUENCE_CLIENT_ID}}",
    "scopes": ["read:confluence-content.all", "read:confluence-space.summary", "offline_access"],
    "extra_params": {
      "audience": "api.atlassian.com",
      "prompt": "consent"
    },
    "pkce": true,
    "popup": { "width": 600, "height": 700 },
    "validation_request": {
      "method": "GET",
      "path": "/wiki/api/v2/spaces?limit=1",
      "success_condition": "status == 200",
      "success_extracts": {
        "connected_user": "results[0].name"
      }
    }
  },
  "default_field_map": [
    { "source": "finding_id", "target": "source_id" },
    { "source": "title", "target": "title" },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info",
          "informational": "info"
        }
      }
    },
    { "source": "affected_host", "target": "asset.ip_address" },
    { "source": "hostname", "target": "asset.hostname" },
    { "source": "cvss_score", "target": "cvss_score", "transform": { "type": "float" } },
    { "source": "cve_id", "target": "cve_id" },
    { "source": "description", "target": "description" },
    { "source": "recommendation", "target": "solution" },
    { "source": "evidence", "target": "plugin_output" },
    { "source": "port", "target": "port" },
    { "source": "protocol", "target": "protocol" },
    { "source": "references", "target": "references" },
    {
      "source": "exploit_available",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["true", "True", "1", "yes"]
      }
    }
  ],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "space_id": {
      "type": "string",
      "required": false,
      "description": "Confluence space ID to pull pages from. Leave empty for all spaces."
    },
    "cql_filter": {
      "type": "string",
      "required": false,
      "description": "Optional CQL filter (e.g. 'label = security AND lastModified > now(\"-30d\")')"
    }
  }
}
