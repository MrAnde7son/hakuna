{
  "id": "freshservice_findings",
  "relay_capable": true,
  "name": "Freshservice \u2014 Tickets as Findings",
  "description": "Pull incident tickets from Freshservice and map them to findings for tracking",
  "category": "ITSM / Ticketing",
  "logo": "/logos/vendors/freshservice.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://{{credentials.domain}}.freshservice.com",
    "method": "GET",
    "path": "/api/v2/tickets",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Basic {{credentials.api_key_base64}}"
    },
    "query_params": {
      "type": "Incident",
      "include": "stats",
      "per_page": "100",
      "page": "{{pagination.page}}"
    },
    "pagination": {
      "strategy": "page",
      "page_size": 100,
      "page_param": "page"
    }
  },
  "records_path": "tickets",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Log into Freshservice as an administrator"
      },
      {
        "instruction": "Enter your Freshservice subdomain (the part before .freshservice.com)",
        "capture": {
          "field": "domain",
          "label": "Subdomain",
          "type": "text",
          "placeholder": "yourcompany",
          "auto_validate": false
        }
      },
      {
        "instruction": "Go to your Profile Settings and copy your API Key. The API key is used as the username for Basic auth (with 'X' as the password).",
        "deeplink_path": "/support/profile",
        "capture": {
          "field": "api_key",
          "label": "API Key",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/api/v2/tickets?per_page=1",
      "headers": {
        "Authorization": "Basic {{api_key_base64}}"
      },
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Freshservice. Verify your subdomain and API key."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "subject",
      "target": "title"
    },
    {
      "source": "description_text",
      "target": "description"
    },
    {
      "source": "priority",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "1": "high",
          "2": "medium",
          "3": "low",
          "4": "info"
        }
      }
    },
    {
      "source": "department_id",
      "target": "asset.hostname"
    },
    {
      "source": "tags",
      "target": "tags"
    },
    {
      "source": "created_at",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "updated_at",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "status",
      "target": "status",
      "transform": {
        "type": "map",
        "mapping": {
          "2": "open",
          "3": "open",
          "4": "resolved",
          "5": "resolved"
        }
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {}
}
