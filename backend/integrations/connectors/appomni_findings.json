{
  "id": "appomni_findings",
  "name": "AppOmni \u2014 SaaS Alerts",
  "description": "Pull SaaS security alerts from AppOmni",
  "category": "SSPM",
  "logo": "/logos/vendors/appomni.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.appomni.com",
    "method": "GET",
    "path": "/api/v1/alerts",
    "headers": {
      "Authorization": "Bearer {{credentials.api_key}}"
    },
    "query_params": {},
    "pagination": {
      "strategy": "cursor",
      "page_size": 100,
      "cursor_field": "meta.next_cursor",
      "cursor_param": "cursor"
    }
  },
  "records_path": "data",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Log into the AppOmni console as an administrator",
        "deeplink_path": null
      },
      {
        "instruction": "Navigate to Settings \u2192 API Keys",
        "deeplink_path": "/settings/api-keys"
      },
      {
        "instruction": "Click Create API Key. Copy the generated key.",
        "capture": {
          "field": "api_key",
          "label": "Paste API Key here",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/api/v1/alerts?limit=1",
      "auth_header": "Authorization: Bearer {{api_key}}",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with AppOmni. Check your API key and try again."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "informational": "info"
        }
      }
    },
    {
      "source": "service_name",
      "target": "asset.hostname"
    },
    {
      "source": "remediation",
      "target": "solution"
    },
    {
      "source": "detected_at",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "updated_at",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {}
}
