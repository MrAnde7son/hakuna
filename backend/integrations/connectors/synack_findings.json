{
  "id": "synack_findings",
  "name": "Synack \u2014 Vulnerabilities",
  "description": "Pull vulnerability findings from Synack Red Team platform",
  "category": "Bug Bounty",
  "logo": "/logos/vendors/synack.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.synack.com",
    "method": "GET",
    "path": "/api/v2/vulnerabilities",
    "headers": {
      "Authorization": "Bearer {{credentials.api_token}}",
      "Accept": "application/json"
    },
    "query_params": {
      "per_page": "50"
    },
    "pagination": {
      "strategy": "page",
      "page_size": 50,
      "page_param": "page"
    }
  },
  "records_path": "vulnerabilities",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "fields": [
      {
        "field": "api_token",
        "label": "API Token",
        "type": "password",
        "help": "Your Synack API bearer token"
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/api/v2/vulnerabilities?per_page=1",
      "headers": {
        "Authorization": "Bearer {{credentials.api_token}}"
      },
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Synack. Verify your API token."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "CRITICAL": "critical",
          "HIGH": "high",
          "MEDIUM": "medium",
          "LOW": "low",
          "INFORMATIONAL": "info"
        }
      }
    },
    {
      "source": "target",
      "target": "asset.hostname"
    },
    {
      "source": "cvss_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "cvss_vector",
      "target": "cvss_vector"
    },
    {
      "source": "cve_ids[0]",
      "target": "cve_id"
    },
    {
      "source": "recommendation",
      "target": "solution"
    },
    {
      "source": "created_at",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "updated_at",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "status",
      "target": "status",
      "transform": {
        "type": "map",
        "mapping": {
          "new": "open",
          "triaged": "open",
          "resolved": "resolved",
          "rejected": "accepted"
        }
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "listing_id": {
      "type": "string",
      "default": "",
      "description": "Filter vulnerabilities by Synack listing (target) ID"
    },
    "severity": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Filter by severity (CRITICAL, HIGH, MEDIUM, LOW, INFORMATIONAL)"
    }
  }
}
