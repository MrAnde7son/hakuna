{
  "id": "gcp_scc_findings",
  "name": "GCP Security Command Center \u2014 Findings",
  "description": "Pull security findings from Google Cloud Security Command Center",
  "category": "Cloud Security",
  "logo": "/logos/vendors/gcp.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://securitycenter.googleapis.com",
    "method": "GET",
    "path": "/v1/organizations/{{credentials.organization_id}}/sources/-/findings",
    "headers": {
      "Accept": "application/json"
    },
    "auth_strategy": "gcp_service_account",
    "gcp_scopes": ["https://www.googleapis.com/auth/cloud-platform"],
    "query_params": {
      "filter": "{{params.filter}}",
      "pageSize": "1000"
    },
    "pagination": {
      "strategy": "cursor",
      "page_size": 1000,
      "cursor_field": "nextPageToken",
      "cursor_param": "pageToken"
    }
  },
  "records_path": "listFindingsResults",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Go to the GCP Console → IAM & Admin → Service Accounts"
      },
      {
        "instruction": "Create a service account (or use an existing one) with the Security Center Findings Viewer role (roles/securitycenter.findingsViewer)"
      },
      {
        "instruction": "Create a JSON key for the service account and open the downloaded file"
      },
      {
        "instruction": "Enter your GCP Organization ID (found in Resource Manager)",
        "capture": {
          "field": "organization_id",
          "label": "GCP Organization ID",
          "type": "text"
        }
      },
      {
        "instruction": "Copy the client_email from the JSON key file",
        "capture": {
          "field": "service_account_email",
          "label": "Service Account Email",
          "type": "text"
        }
      },
      {
        "instruction": "Copy the private_key from the JSON key file (the entire string including -----BEGIN/END-----)",
        "capture": {
          "field": "private_key",
          "label": "Service Account Private Key",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "auth_type": "gcp_service_account",
    "scopes": ["https://www.googleapis.com/auth/cloud-platform"],
    "validation_request": {
      "method": "GET",
      "path": "/v1/organizations/{{organization_id}}/sources/-/findings",
      "query_params": {
        "pageSize": "1"
      },
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with GCP Security Command Center. Verify your organization ID and service account credentials."
    }
  },
  "default_field_map": [
    {
      "source": "finding.name",
      "target": "source_id"
    },
    {
      "source": "finding.category",
      "target": "title"
    },
    {
      "source": "finding.description",
      "target": "description"
    },
    {
      "source": "finding.severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "CRITICAL": "critical",
          "HIGH": "high",
          "MEDIUM": "medium",
          "LOW": "low"
        }
      }
    },
    {
      "source": "finding.resourceName",
      "target": "asset.hostname"
    },
    {
      "source": "finding.resourceName",
      "target": "asset.asset_type",
      "transform": {
        "type": "expression",
        "expr": "'cloud_instance'"
      }
    },
    {
      "source": "finding.resourceName",
      "target": "asset.asset_identity",
      "transform": {
        "type": "expression",
        "expr": "{'cloud_provider': 'gcp', 'instance_id': str(value) if value else ''}"
      }
    },
    {
      "source": "finding.vulnerability.cve.id",
      "target": "cve_id"
    },
    {
      "source": "finding.sourceProperties.ReactiveCvss.baseScore",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "finding.vulnerability.cve.exploitationActivity",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["WIDE", "CONFIRMED"]
      }
    },
    {
      "source": "finding.sourceProperties.Recommendation",
      "target": "solution"
    },
    {
      "source": "finding.createTime",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "finding.eventTime",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "finding.state",
      "target": "status",
      "transform": {
        "type": "map",
        "mapping": {
          "ACTIVE": "open",
          "INACTIVE": "resolved"
        }
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "organization_id": {
      "type": "string",
      "required": true,
      "description": "GCP Organization ID (numeric)"
    },
    "filter": {
      "type": "string",
      "default": "state=\"ACTIVE\"",
      "description": "SCC finding filter expression"
    }
  }
}
