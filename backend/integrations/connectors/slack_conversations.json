{
  "id": "slack_conversations",
  "name": "Slack — Security Conversations",
  "description": "Pull messages from Slack channels and extract security findings using AI. Monitors security-related channels for vulnerability discussions, incident reports, and remediation updates.",
  "logo": "/logos/vendors/slack.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://slack.com",
    "steps": [
      {
        "id": "get_messages",
        "method": "GET",
        "path": "/api/conversations.history",
        "headers": {
          "Authorization": "Bearer {{credentials.bot_token}}"
        },
        "query_params": {
          "channel": "{{params.channel_id}}",
          "limit": "200",
          "oldest": "{{params.oldest}}",
          "cursor": "{{pagination.cursor}}"
        }
      }
    ],
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "response_metadata.next_cursor",
      "page_size": 200
    },
    "llm_extract": {
      "text_field": "text",
      "title_field": "user",
      "url_field": "permalink"
    }
  },
  "records_path": "messages",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Create a Slack App at api.slack.com/apps with the following Bot Token Scopes: channels:history, channels:read, groups:history, groups:read"
      },
      {
        "instruction": "Install the app to your workspace and copy the Bot User OAuth Token (starts with xoxb-)",
        "capture": {
          "field": "bot_token",
          "label": "Paste Bot Token (xoxb-...)",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/api/auth.test",
      "headers": {
        "Authorization": "Bearer {{bot_token}}"
      },
      "success_condition": "response.ok == true",
      "success_extracts": {
        "connected_user": "response.user"
      },
      "error_message": "Could not authenticate with Slack. Check the bot token and ensure the app is installed."
    }
  },
  "default_field_map": [
    { "source": "finding_id", "target": "source_id" },
    { "source": "title", "target": "title" },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info",
          "informational": "info"
        }
      }
    },
    { "source": "affected_host", "target": "asset.ip_address" },
    { "source": "hostname", "target": "asset.hostname" },
    { "source": "cvss_score", "target": "cvss_score", "transform": { "type": "float" } },
    { "source": "cve_id", "target": "cve_id" },
    { "source": "description", "target": "description" },
    { "source": "recommendation", "target": "solution" },
    { "source": "evidence", "target": "plugin_output" },
    { "source": "port", "target": "port" },
    { "source": "references", "target": "references" },
    {
      "source": "exploit_available",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["true", "True", "1", "yes"]
      }
    }
  ],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "channel_id": {
      "type": "string",
      "required": true,
      "description": "Slack channel ID (e.g. C01ABCDEF). Find it in channel details → About."
    },
    "oldest": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Only fetch messages after this Unix timestamp. Leave empty for last 90 days."
    }
  }
}
