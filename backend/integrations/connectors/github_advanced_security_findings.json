{
  "id": "github_advanced_security_findings",
  "name": "GitHub Advanced Security \u2014 Findings",
  "description": "Pull code scanning alerts from GitHub Advanced Security across an organization",
  "category": "SAST",
  "logo": "/logos/vendors/github.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.github.com",
    "method": "GET",
    "path": "/orgs/{{params.org}}/code-scanning/alerts",
    "headers": {
      "Authorization": "Bearer {{credentials.token}}",
      "Accept": "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28"
    },
    "query_params": {
      "per_page": "100",
      "page": "{{pagination.page}}"
    },
    "pagination": {
      "strategy": "page",
      "page_size": 100,
      "page_param": "page"
    }
  },
  "records_path": "",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "fields": [
      {
        "field": "token",
        "label": "Personal Access Token",
        "type": "password",
        "help": "A GitHub PAT with 'security_events' scope. Generate at Settings > Developer settings > Personal access tokens."
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/user",
      "headers": {
        "Authorization": "Bearer {{credentials.token}}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with GitHub. Verify your personal access token has the 'security_events' scope."
    }
  },
  "default_field_map": [
    {
      "source": "number",
      "target": "source_id"
    },
    {
      "source": "rule.description",
      "target": "title"
    },
    {
      "source": "most_recent_instance.message.text",
      "target": "description"
    },
    {
      "source": "rule.security_severity_level",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "warning": "medium",
          "note": "info",
          "error": "high"
        }
      }
    },
    {
      "source": "repository.full_name",
      "target": "asset.hostname"
    },
    {
      "source": "repository.full_name",
      "target": "asset.asset_type",
      "transform": {
        "type": "expression",
        "expr": "'code_repo'"
      }
    },
    {
      "source": "repository.full_name",
      "target": "asset.asset_identity",
      "transform": {
        "type": "expression",
        "expr": "{'provider': 'github', 'org': value.split('/')[0] if '/' in str(value) else '', 'repo': value.split('/')[-1] if value else ''}"
      }
    },
    {
      "source": "rule.id",
      "target": "plugin_id"
    },
    {
      "source": "tool.name",
      "target": "source_system"
    },
    {
      "source": "created_at",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "updated_at",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "state",
      "target": "status",
      "transform": {
        "type": "map",
        "mapping": {
          "open": "open",
          "closed": "resolved",
          "dismissed": "accepted",
          "fixed": "resolved"
        }
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id",
    "asset.hostname"
  ],
  "params_schema": {
    "org": {
      "type": "string",
      "required": true,
      "description": "GitHub organization name"
    }
  }
}
