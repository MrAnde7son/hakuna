{
  "id": "aws_bedrock_guardrails",
  "name": "AWS Bedrock — Guardrails",
  "description": "List Bedrock Guardrails in the region. Used by the managed_ai mission to flag accounts that invoke Bedrock without any guardrail attached (no prompt-injection / content-filtering policy).",
  "category": "AI Governance",
  "logo": "/logos/vendors/aws.svg",
  "direction": "pull",
  "entity": "audit_only",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://bedrock.{{credentials.region}}.amazonaws.com",
    "method": "GET",
    "path": "/guardrails",
    "headers": {},
    "query_params": {},
    "auth_strategy": "aws_sigv4",
    "aws_service": "bedrock",
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "nextToken",
      "cursor_param": "nextToken",
      "page_size": 100,
      "page_size_param": "maxResults"
    }
  },
  "records_path": "guardrails",
  "credential_acquisition": {
    "pattern": "shared_credential",
    "shared_with": "aws_iam_users"
  },
  "default_field_map": [],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "region": {
      "type": "string",
      "required": true,
      "default": "us-east-1"
    }
  }
}
