{
  "id": "jira_create_ticket",
  "relay_capable": true,
  "name": "Jira — Create Ticket",
  "description": "Push findings to Jira as new issues",
  "logo": "/logos/vendors/jira.svg",
  "direction": "push",
  "entity": "action",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "POST",
    "path": "/rest/api/3/issue",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "body": {
      "fields": {
        "project": { "key": "{{params.project_key}}" },
        "summary": "[{{finding.severity|upper}}] {{finding.title}} on {{asset.hostname}}",
        "description": "CVE: {{finding.cve_id}}\nCVSS: {{finding.cvss_score}}\n\nSolution:\n{{finding.solution}}",
        "issuetype": { "name": "{{params.issue_type}}" },
        "priority": { "name": "{{finding.severity|capitalize}}" }
      }
    }
  },
  "records_path": null,
  "credential_acquisition": {
    "pattern": "oauth2",
    "instance_url_field": {
      "label": "Your Jira workspace URL",
      "placeholder": "https://yourcompany.atlassian.net"
    },
    "authorization_url": "https://auth.atlassian.com/authorize",
    "token_url": "https://auth.atlassian.com/oauth/token",
    "token_request_format": "json",
    "client_id": "{{env.JIRA_CLIENT_ID}}",
    "scopes": ["read:jira-work", "write:jira-work", "offline_access"],
    "extra_params": {
      "audience": "api.atlassian.com",
      "prompt": "consent"
    },
    "pkce": true,
    "popup": { "width": 600, "height": 700 },
    "validation_request": {
      "method": "GET",
      "path": "/rest/api/3/myself",
      "success_extracts": {
        "connected_user": "response.displayName",
        "connected_email": "response.emailAddress"
      }
    }
  },
  "default_field_map": [],
  "dedup_key": [],
  "params_schema": {
    "project_key": {
      "type": "string",
      "required": true,
      "description": "Jira project key (e.g. SEC)"
    },
    "issue_type": {
      "type": "string",
      "default": "Bug",
      "description": "Issue type (Bug, Task, Story)"
    }
  }
}
