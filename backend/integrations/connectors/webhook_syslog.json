{
  "id": "webhook_syslog",
  "name": "Syslog (RFC 5424)",
  "description": "Receive events in RFC 5424 syslog format via HTTP relay",
  "category": "Event Ingest",
  "logo": "/logos/vendors/syslog.svg",
  "direction": "push",
  "entity": "siem_event",
  "transport_type": "webhook",
  "transport_config": {
    "parser_type": "syslog_rfc5424"
  },
  "default_field_map": [
    { "source": "timestamp", "target": "event_time", "transform": { "type": "datetime" } },
    { "source": "hostname", "target": "source_system" },
    { "source": "appname", "target": "event_type" },
    { "source": "severity", "target": "severity" },
    { "source": "message", "target": "message" }
  ],
  "dedup_key": ["source_system", "source_id"],
  "sample_payload": "<134>1 2024-03-15T14:30:00Z firewall-01 sshd 12345 - - Failed password for user admin from 192.168.1.100 port 22 ssh2"
}
