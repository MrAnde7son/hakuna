{
  "id": "anthropic_admin_workspace_members",
  "name": "Anthropic Admin — Workspace Members",
  "description": "List members for a specific workspace. Used by identity mission to walk workspace boundaries and detect cross-workspace privilege bleed.",
  "category": "AI Governance",
  "logo": "/logos/vendors/anthropic.svg",
  "direction": "pull",
  "entity": "audit_only",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.anthropic.com/v1",
    "method": "GET",
    "path": "/organizations/workspaces/{{params.workspace_id}}/members",
    "headers": {
      "x-api-key": "{{credentials.admin_api_key}}",
      "anthropic-version": "2023-06-01"
    },
    "query_params": {},
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "last_id",
      "cursor_param": "after_id",
      "page_size": 100,
      "page_size_param": "limit"
    }
  },
  "records_path": "data",
  "credential_acquisition": {
    "pattern": "shared_credential",
    "shared_with": "anthropic_admin_workspaces"
  },
  "default_field_map": [],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "workspace_id": {
      "type": "string",
      "required": true,
      "description": "Workspace id (from anthropic_admin_workspaces) whose members to enumerate."
    }
  }
}
