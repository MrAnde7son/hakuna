{
  "id": "cycognito_issues",
  "relay_capable": false,
  "name": "CyCognito — Issues",
  "description": "Pull security issues from CyCognito EASM platform",
  "category": "EASM",
  "logo": "/logos/vendors/cycognito.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{credentials.instance_url}}",
    "method": "POST",
    "path": "/v1/issues",
    "headers": {
      "Authorization": "{{credentials.api_key}}",
      "Content-Type": "application/json"
    },
    "query_params": {
      "count": "100",
      "offset": "{{pagination.offset}}",
      "sort-by": "last-detected",
      "sort-order": "desc"
    },
    "body": "{{params.filters}}",
    "pagination": {
      "strategy": "offset",
      "page_size": 100,
      "offset_param": "offset",
      "total_field": "total"
    }
  },
  "records_path": "issues",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "instance_url_field": {
      "label": "API Base URL",
      "placeholder": "https://api.platform.cycognito.com",
      "help": "Use https://api.us-platform.cycognito.com for US region, or your region-specific URL"
    },
    "steps": [
      {
        "instruction": "Log into the CyCognito platform at https://platform.cycognito.com"
      },
      {
        "instruction": "Navigate to Settings > Integrations > API Keys"
      },
      {
        "instruction": "Click 'Create API Key' and copy the generated key",
        "capture": {
          "field": "api_key",
          "label": "API Key",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "POST",
      "path": "/v1/issues",
      "headers": {
        "Authorization": "{{api_key}}",
        "Content-Type": "application/json"
      },
      "query_params": {
        "count": "1",
        "offset": "0"
      },
      "body": "[]",
      "success_condition": "status == 200",
      "error_message": "Authentication failed. Verify your API key and base URL."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "issue_id",
      "target": "plugin_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "summary",
      "target": "description"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info",
          "informational": "info"
        }
      }
    },
    {
      "source": "severity_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "affected_asset",
      "target": "asset.hostname"
    },
    {
      "source": "exploitation_score",
      "target": "exploit_available",
      "transform": {
        "type": "expression",
        "expr": "value is not None and float(value) > 5.0"
      }
    },
    {
      "source": "remediation_steps",
      "target": "solution",
      "transform": {
        "type": "expression",
        "expr": "'; '.join(value) if isinstance(value, list) else (value or '')"
      }
    },
    {
      "source": "first_detected",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_detected",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "investigation_status",
      "target": "status",
      "transform": {
        "type": "map",
        "mapping": {
          "uninvestigated": "open",
          "investigating": "in_progress",
          "investigated": "resolved",
          "archived": "resolved"
        }
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "filters": {
      "type": "string",
      "default": "[]",
      "description": "JSON array of filters, e.g. [{\"field\": \"severity\", \"op\": \"in\", \"values\": [\"critical\", \"high\"]}]"
    }
  }
}
