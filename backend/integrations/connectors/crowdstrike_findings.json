{
  "id": "crowdstrike_findings",
  "relay_capable": true,
  "name": "CrowdStrike Spotlight \u2014 Findings",
  "description": "Pull vulnerability findings from CrowdStrike Spotlight",
  "category": "Endpoint Security",
  "logo": "/logos/vendors/crowdstrike.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.crowdstrike.com",
    "method": "GET",
    "path": "/spotlight/combined/vulnerabilities/v1",
    "headers": {},
    "query_params": {
      "filter": "{{params.filter}}",
      "limit": "100"
    },
    "pagination": {
      "strategy": "cursor",
      "page_size": 100,
      "cursor_field": "meta.pagination.after",
      "cursor_param": "after"
    }
  },
  "records_path": "resources",
  "credential_acquisition": {
    "pattern": "client_credentials",
    "token_url": "https://api.crowdstrike.com/oauth2/token",
    "scopes": ["spotlight-vulnerabilities:read"],
    "fields": [
      { "field": "client_id", "label": "Client ID", "type": "text", "help": "From CrowdStrike API clients page" },
      { "field": "client_secret", "label": "Client Secret", "type": "password", "help": "Generated when you created the API client" }
    ]
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "cve.id",
      "target": "cve_id"
    },
    {
      "source": "cve.description",
      "target": "description"
    },
    {
      "source": "cve.base_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "cve.exploit_status",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": [
          "available",
          "Active"
        ]
      }
    },
    {
      "source": "host_info.hostname",
      "target": "asset.hostname"
    },
    {
      "source": "host_info.local_ip",
      "target": "asset.ip_address"
    },
    {
      "source": "host_info.os_version",
      "target": "asset.os"
    },
    {
      "source": "status",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "none": "info"
        }
      }
    },
    {
      "source": "remediation.action",
      "target": "solution"
    },
    {
      "source": "created_timestamp",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "updated_timestamp",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "filter": {
      "type": "string",
      "default": "status:!'closed'",
      "description": "FQL filter for Spotlight vulnerabilities"
    }
  }
}