{
  "id": "anthropic_admin_api_keys",
  "name": "Anthropic Admin — API Keys",
  "description": "List API keys across the Anthropic organization (with workspace scope, status, and creator). Used by keys_hygiene mission.",
  "category": "AI Governance",
  "logo": "/logos/vendors/anthropic.svg",
  "direction": "pull",
  "entity": "audit_only",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.anthropic.com/v1",
    "method": "GET",
    "path": "/organizations/api_keys",
    "headers": {
      "x-api-key": "{{credentials.admin_api_key}}",
      "anthropic-version": "2023-06-01"
    },
    "query_params": {},
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "last_id",
      "cursor_param": "after_id",
      "page_size": 100,
      "page_size_param": "limit"
    }
  },
  "records_path": "data",
  "credential_acquisition": {
    "pattern": "shared_credential",
    "shared_with": "anthropic_admin_workspaces"
  },
  "default_field_map": [],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "status": {
      "type": "string",
      "required": false,
      "description": "Filter by key status (active | inactive | archived). Omit to list all.",
      "enum": ["active", "inactive", "archived"]
    },
    "workspace_id": {
      "type": "string",
      "required": false,
      "description": "Restrict to keys belonging to a specific workspace_id."
    }
  }
}
