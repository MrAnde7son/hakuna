{
  "id": "notion_pages",
  "name": "Notion — Security Pages",
  "description": "Pull pages from a Notion database or workspace and extract security findings using AI. Ingests security runbooks, incident notes, vulnerability tracking pages, and audit documentation.",
  "category": "Collaboration / Docs",
  "logo": "/logos/vendors/notion.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.notion.com",
    "steps": [
      {
        "id": "query_database",
        "method": "POST",
        "path": "/v1/databases/{{params.database_id}}/query",
        "headers": {
          "Authorization": "Bearer {{credentials.api_key}}",
          "Notion-Version": "2022-06-28",
          "Content-Type": "application/json"
        },
        "body": {
          "page_size": 100,
          "start_cursor": "{{pagination.cursor}}"
        }
      },
      {
        "id": "get_page_content",
        "method": "GET",
        "path": "/v1/blocks/{{record.id}}/children?page_size=100",
        "headers": {
          "Authorization": "Bearer {{credentials.api_key}}",
          "Notion-Version": "2022-06-28"
        },
        "per_record": true,
        "inject_as": "blocks"
      }
    ],
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "next_cursor",
      "page_size": 100
    },
    "llm_extract": {
      "text_field": "blocks.plain_text",
      "title_field": "properties.Name.title.0.plain_text",
      "url_field": "url"
    }
  },
  "records_path": "results",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Go to notion.so/my-integrations and create a new Internal Integration. Give it 'Read content' capabilities."
      },
      {
        "instruction": "Copy the Internal Integration Secret (starts with ntn_ or secret_)",
        "capture": {
          "field": "api_key",
          "label": "Paste Integration Secret",
          "type": "password",
          "auto_validate": true
        }
      },
      {
        "instruction": "Share your target database or pages with the integration by clicking '...' → 'Connect to' on each page/database."
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/v1/users/me",
      "headers": {
        "Authorization": "Bearer {{api_key}}",
        "Notion-Version": "2022-06-28"
      },
      "success_condition": "status == 200",
      "success_extracts": {
        "connected_user": "name"
      },
      "error_message": "Could not authenticate with Notion. Check the integration secret."
    }
  },
  "default_field_map": [
    { "source": "finding_id", "target": "source_id" },
    { "source": "title", "target": "title" },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info",
          "informational": "info"
        }
      }
    },
    { "source": "affected_host", "target": "asset.ip_address" },
    { "source": "hostname", "target": "asset.hostname" },
    { "source": "cvss_score", "target": "cvss_score", "transform": { "type": "float" } },
    { "source": "cve_id", "target": "cve_id" },
    { "source": "description", "target": "description" },
    { "source": "recommendation", "target": "solution" },
    { "source": "evidence", "target": "plugin_output" },
    { "source": "references", "target": "references" },
    {
      "source": "exploit_available",
      "target": "exploit_available",
      "transform": {
        "type": "boolean",
        "truthy": ["true", "True", "1", "yes"]
      }
    }
  ],
  "dedup_key": ["source_system", "source_id"],
  "params_schema": {
    "database_id": {
      "type": "string",
      "required": true,
      "description": "Notion database ID. Find it in the database URL: notion.so/{workspace}/{database_id}?v=..."
    }
  }
}
