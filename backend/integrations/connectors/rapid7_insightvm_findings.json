{
  "id": "rapid7_insightvm_findings",
  "name": "Rapid7 InsightVM \u2014 Findings",
  "description": "Pull vulnerability findings from Rapid7 InsightVM via the REST API",
  "category": "Vulnerability Management",
  "logo": "/logos/vendors/rapid7.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "GET",
    "path": "/api/3/vulnerability_results",
    "headers": {
      "Accept": "application/json"
    },
    "query_params": {
      "size": "100"
    },
    "pagination": {
      "strategy": "page",
      "page_size": 100,
      "page_param": "page",
      "size_param": "size",
      "total_field": "page.totalResources"
    }
  },
  "records_path": "resources",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "instance_url_field": {
      "label": "InsightVM Console URL",
      "placeholder": "https://insightvm.example.com:3780"
    },
    "fields": [
      {
        "field": "username",
        "label": "Username",
        "type": "text",
        "help": "InsightVM API username (leave empty if using API key only)",
        "required": false
      },
      {
        "field": "api_key",
        "label": "API Key",
        "type": "password",
        "help": "API key generated from InsightVM console under Administration > User Management"
      }
    ],
    "auth_header": {
      "type": "basic",
      "username": "{{credentials.username}}",
      "password": "{{credentials.api_key}}"
    },
    "validation_request": {
      "method": "GET",
      "path": "/api/3/administration/info",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with InsightVM. Verify your console URL and API key."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "Critical": "critical",
          "Severe": "high",
          "Moderate": "medium",
          "Low": "low"
        }
      }
    },
    {
      "source": "cvss.v3.score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "asset.host_name",
      "target": "asset.hostname"
    },
    {
      "source": "asset.ip",
      "target": "asset.ip_address"
    },
    {
      "source": "cve",
      "target": "cve_id"
    },
    {
      "source": "solutions[0].summary",
      "target": "solution"
    },
    {
      "source": "found_on",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_found_on",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "size": {
      "type": "integer",
      "default": 100,
      "description": "Number of results per page (max 500)"
    },
    "severity_filter": {
      "type": "string",
      "default": "",
      "description": "Filter by severity level (Critical, Severe, Moderate, Low)"
    }
  }
}
