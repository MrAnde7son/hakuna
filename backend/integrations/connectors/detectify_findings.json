{
  "id": "detectify_findings",
  "name": "Detectify \u2014 Findings",
  "description": "Pull security findings from Detectify surface monitoring and application scanning",
  "category": "DAST",
  "logo": "/logos/vendors/detectify.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://api.detectify.com",
    "method": "GET",
    "path": "/rest/v2/findings",
    "headers": {
      "Accept": "application/json",
      "X-Detectify-Key": "{{credentials.api_key}}"
    },
    "query_params": {},
    "pagination": {
      "strategy": "cursor",
      "cursor_field": "next_cursor",
      "cursor_param": "cursor"
    }
  },
  "records_path": "findings",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "fields": [
      {
        "field": "api_key",
        "label": "API Key",
        "type": "password",
        "help": "API key from Detectify under Team Settings > API keys"
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/rest/v2/domains",
      "headers": {
        "X-Detectify-Key": "{{credentials.api_key}}"
      },
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Detectify. Check your API key."
    }
  },
  "default_field_map": [
    {
      "source": "uuid",
      "target": "source_id"
    },
    {
      "source": "title",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "severity",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "critical": "critical",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "info": "info"
        }
      }
    },
    {
      "source": "host",
      "target": "asset.hostname"
    },
    {
      "source": "host",
      "target": "asset.asset_type",
      "transform": {
        "type": "expression",
        "expr": "'web_app'"
      }
    },
    {
      "source": "host",
      "target": "asset.asset_identity",
      "transform": {
        "type": "expression",
        "expr": "{'url': str(value) if value else ''}"
      }
    },
    {
      "source": "ip_address",
      "target": "asset.ip_address"
    },
    {
      "source": "cvss_score",
      "target": "cvss_score",
      "transform": {
        "type": "float"
      }
    },
    {
      "source": "cve_id",
      "target": "cve_id"
    },
    {
      "source": "fix",
      "target": "solution"
    },
    {
      "source": "found_at",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_found_at",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "severity_filter": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Filter by severity (critical, high, medium, low, info)"
    }
  }
}
