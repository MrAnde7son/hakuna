{
  "id": "picus_findings",
  "name": "Picus Security — Findings",
  "description": "Pull attack simulation and security control validation findings from Picus Security",
  "category": "BAS",
  "logo": "/logos/vendors/picus.svg",
  "direction": "pull",
  "entity": "finding",
  "transport_type": "api",
  "transport_config": {
    "base_url": "{{instance_url}}",
    "method": "GET",
    "path": "/api/v1/simulation-results",
    "headers": {
      "Accept": "application/json"
    },
    "query_params": {
      "size": "100"
    },
    "pagination": {
      "strategy": "offset",
      "page_size": 100,
      "offset_param": "page"
    }
  },
  "records_path": "results",
  "credential_acquisition": {
    "pattern": "guided_generation",
    "instance_url_field": true,
    "fields": [
      {
        "field": "instance_url",
        "label": "Picus Platform URL",
        "type": "text",
        "help": "Your Picus platform URL (e.g., https://app.picussecurity.com)"
      },
      {
        "field": "api_key",
        "label": "API Key",
        "type": "password",
        "help": "API key from Picus Settings → Integrations → API Access"
      }
    ],
    "auth_type": "header",
    "auth_header": "X-Api-Key",
    "auth_value": "{{credentials.api_key}}",
    "validation_request": {
      "method": "GET",
      "path": "/api/v1/simulation-results?size=1",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Picus. Verify your platform URL and API key."
    }
  },
  "default_field_map": [
    {
      "source": "id",
      "target": "source_id"
    },
    {
      "source": "threat_name",
      "target": "title"
    },
    {
      "source": "description",
      "target": "description"
    },
    {
      "source": "action_result",
      "target": "severity",
      "transform": {
        "type": "map",
        "mapping": {
          "Not Prevented": "critical",
          "Not Detected": "high",
          "Detected": "medium",
          "Prevented": "info"
        }
      }
    },
    {
      "source": "peer.ip",
      "target": "asset.ip_address"
    },
    {
      "source": "peer.hostname",
      "target": "asset.hostname"
    },
    {
      "source": "cve_list",
      "target": "cve_id",
      "transform": {
        "type": "first"
      }
    },
    {
      "source": "mitre_technique_id",
      "target": "mitre_technique_id"
    },
    {
      "source": "mitigation_suggestions",
      "target": "solution"
    },
    {
      "source": "run_date",
      "target": "first_seen",
      "transform": {
        "type": "datetime"
      }
    },
    {
      "source": "last_run_date",
      "target": "last_seen",
      "transform": {
        "type": "datetime"
      }
    }
  ],
  "dedup_key": [
    "source_system",
    "source_id"
  ],
  "params_schema": {
    "campaign_id": {
      "type": "string",
      "default": "",
      "description": "Filter results to a specific simulation campaign"
    },
    "action_result": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["Not Prevented", "Not Detected"],
      "description": "Filter by action result (Not Prevented, Not Detected, Detected, Prevented)"
    }
  }
}
