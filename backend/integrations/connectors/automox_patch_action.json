{
  "id": "automox_patch_action",
  "name": "Automox \u2014 Execute Patch",
  "description": "Trigger immediate patch execution on a device via Automox",
  "category": "Patch Management",
  "logo": "/logos/vendors/automox.svg",
  "direction": "push",
  "entity": "action",
  "transport_type": "api",
  "transport_config": {
    "base_url": "https://console.automox.com/api",
    "method": "POST",
    "path": "/servers/{{params.device_id}}/queues",
    "headers": {
      "Authorization": "Bearer {{credentials.api_key}}",
      "Content-Type": "application/json"
    },
    "body": {
      "action": "InstallUpdate",
      "patch_id": "{{params.patch_id}}"
    }
  },
  "records_path": null,
  "credential_acquisition": {
    "pattern": "guided_generation",
    "steps": [
      {
        "instruction": "Log into the Automox console at console.automox.com",
        "deeplink_path": null
      },
      {
        "instruction": "Navigate to Settings \u2192 API Keys",
        "deeplink_path": "/settings/api-keys"
      },
      {
        "instruction": "Generate a new API key with device management permissions. Copy the key value.",
        "capture": {
          "field": "api_key",
          "label": "Paste API Key here",
          "type": "password",
          "auto_validate": true
        }
      }
    ],
    "validation_request": {
      "method": "GET",
      "path": "/servers?limit=1",
      "auth_header": "Authorization: Bearer {{api_key}}",
      "success_condition": "status == 200",
      "error_message": "Could not authenticate with Automox. Check your API key."
    }
  },
  "default_field_map": [],
  "dedup_key": [],
  "params_schema": {
    "device_id": {
      "type": "string",
      "required": true,
      "description": "Automox device/server ID to patch"
    },
    "patch_id": {
      "type": "string",
      "required": true,
      "description": "Automox patch ID to install"
    }
  }
}
