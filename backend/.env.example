INTEGRATION_SECRET_KEY=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vertex AI — enables Gemini models via GCP ADC (no API key needed)
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# PostHog product analytics (optional — leave unset to disable)
# Use the project API key (starts with phc_) from Project Settings.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
